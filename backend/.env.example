APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_ENABLE_BACKGROUND_JOBS=true

SQLSERVER_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=localhost\SQLEXPRESS;Database=DataGetGoals;Trusted_Connection=yes;Encrypt=no;TrustServerCertificate=yes;Connect Timeout=5;
SQLSERVER_ODBC_DRIVER=ODBC Driver 18 for SQL Server

FRONTEND_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

AUTH_JWT_KEY=your-jwt-secret-here
AUTH_ISSUER=GetGoals
AUTH_AUDIENCE=GetGoals.Web
AUTH_GOOGLE_CLIENT_ID=your-google-client-id
AUTH_GOOGLE_EXCHANGE_SECRET=your-google-exchange-secret

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

PAYMENT_BANK_CODE=MB
PAYMENT_BANK_ACCOUNT_NO=your-bank-account-number
PAYMENT_BANK_ACCOUNT_NAME=your-bank-account-name

PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key
PAYOS_RETURN_URL=http://localhost:5173/pricing
PAYOS_CANCEL_URL=http://localhost:5173/pricing
